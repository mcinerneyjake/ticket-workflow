# Turns the engines floors from a warning into a refusal: without it npm prints EBADENGINE and
# rewrites package-lock.json anyway, which is how npm 11.5.1 stripped `libc` from all ten optional
# native entries (tkt-e4089552c6f6). The protection is the floor on the ROOT package — measured in
# npm 11.19.1, engine-strict reaches neither an optional dependency's own engines (arborist ignores
# it there) nor engines.node on the git-tag path, where pacote installs with `--force`. Consumers
# inherit this file, so a floor above what Node 24 bundles fails their installs too (tkt-61ec9c048684).
engine-strict=true
