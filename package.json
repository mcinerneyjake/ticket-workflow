{
  "name": "ticket-workflow",
  "version": "0.16.0",
  "description": "Local-first, per-repo ticket board + git/PR pipeline: an MCP server, guard/telemetry Bash hooks, and a pipeline CLI. Decoupled — each repo owns its own tickets/ + events/.",
  "license": "MIT",
  "author": "Jake McInerney",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ticket-workflow-mcp": "dist/mcp/server.js",
    "ticket-workflow": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks/guard-bash.mjs": "./hooks/guard-bash.mjs",
    "./hooks/guard-review-target.mjs": "./hooks/guard-review-target.mjs",
    "./hooks/guard-subagent-gates.mjs": "./hooks/guard-subagent-gates.mjs",
    "./hooks/guard-ticket.mjs": "./hooks/guard-ticket.mjs",
    "./hooks/track-steps.mjs": "./hooks/track-steps.mjs",
    "./hooks/warn-stale-worktree.mjs": "./hooks/warn-stale-worktree.mjs"
  },
  "files": [
    "dist",
    "templates",
    "hooks/lib/default-branch.mjs",
    "hooks/lib/is-main.mjs",
    "hooks/guard-bash.mjs",
    "hooks/guard-review-target.mjs",
    "hooks/guard-subagent-gates.mjs",
    "hooks/guard-ticket.mjs",
    "hooks/track-steps.mjs",
    "hooks/warn-stale-worktree.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  }
}
